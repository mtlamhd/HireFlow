@model HireFlow.Mvc.Models.EmployerView.UpdateEmployerProfileViewModel
@{
    ViewData["Title"] = "پروفایل کارفرما";
}

<div style="background-color: #0b0f19; min-height: 100vh; color: #f8fafc; padding: 3rem 0;">
    <div class="container">
        
        <!-- هدر پنل -->
        <div class="d-flex justify-content-between align-items-center mb-5 pb-3 border-bottom border-secondary border-opacity-15">
            <div>
                <span class="badge px-3 py-2 rounded-pill fw-bold mb-2 shadow-sm" style="background: rgba(249, 115, 22, 0.15); color: #fb923c;">🏢 پنل اختصاصی کارفرما</span>
                <h1 class="fw-bold text-white mb-0">مدیریت حساب کاربری و اطلاعات فردی</h1>
            </div>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-light rounded-pill px-4 py-2 border-0 shadow-sm" style="background: rgba(255,255,255,0.05);">← بازگشت به سایت</a>
        </div>

        <!-- پیام‌ها -->
        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-lg mb-4 border-0" role="alert" style="background: rgba(52, 211, 153, 0.15); color: #34d399;">
                ✨ @TempData["Message"]
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-lg mb-4 border-0" role="alert" style="background: rgba(239, 68, 68, 0.15); color: #f87171;">
                ⚠️ @TempData["Error"]
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="row g-4">
            
            <!-- ستون راست: عکس پروفایل و دکمه حذف -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-lg rounded-4 p-4 mb-4 text-center" style="background: #1e293b; border: 1px solid rgba(255,255,255,0.06) !important;">
                    <div class="position-relative d-inline-block mx-auto mb-3">
                        @if (Model.ProfileImageId.HasValue && Model.ProfileImageId.Value != Guid.Empty)
                        {
                            <!-- نمایش عکس آپلود شده -->
                            <img src="@Url.Action("GetAttachment", "Employer", new { id = Model.ProfileImageId })" class="rounded-circle shadow-lg mx-auto" style="width: 110px; height: 110px; object-fit: cover; border: 2px solid rgba(249, 115, 22, 0.5);" alt="Profile Image" />
                        }
                        else
                        {
                            <!-- اگر عکسی نبود -->
                            <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white shadow-lg mx-auto" style="width: 110px; height: 110px; background: linear-gradient(135deg, #f97316 0%, #ea580c 100%); font-size: 36px;">
                                @(string.IsNullOrEmpty(Model.FirstName) ? "👤" : Model.FirstName.Substring(0, 1))
                            </div>
                        }
                    </div>
                    <h5 class="fw-bold text-white mb-1">@(string.IsNullOrEmpty(Model.FirstName) ? "کارفرما عزیز" : $"{Model.FirstName} {Model.LastName}")</h5>
                    <p class="text-secondary small mb-4">@Model.PhoneNumber</p>

                    <!-- فرم آپلود / تغییر عکس -->
                    <form asp-action="UploadProfileImage" method="post" enctype="multipart/form-data" class="mb-2">
                        <input type="file" name="imageFile" accept="image/*" class="form-control form-control-sm bg-dark text-white border-secondary mb-2 rounded-3" required />
                        <button type="submit" class="btn btn-outline-light btn-sm w-100 rounded-3">
                            @(Model.ProfileImageId.HasValue ? "تغییر تصویر پروفایل" : "آپلود تصویر پروفایل")
                        </button>
                    </form>

                    <!-- فرم حذف عکس (فقط اگر عکس وجود داشت نشان داده شود) -->
                    @if (Model.ProfileImageId.HasValue && Model.ProfileImageId.Value != Guid.Empty)
                    {
                        <form asp-action="RemoveProfileImage" method="post" class="mt-2">
                            <button type="submit" class="btn btn-outline-danger btn-sm w-100 rounded-3">
                                🗑️ حذف تصویر پروفایل
                            </button>
                        </form>
                    }
                </div>
            </div>

            <!-- ستون چپ: فرم ویرایش مشخصات با خطاهای زیر فیلد -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5" style="background: #1e293b; border: 1px solid rgba(255,255,255,0.06) !important;">
                    <h4 class="fw-bold text-white mb-4">ویرایش اطلاعات شخصی</h4>

                    <form asp-action="Profile" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3 p-2 bg-danger bg-opacity-10 rounded-3"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small text-secondary fw-bold">نام</label>
                                <input asp-for="FirstName" class="form-control bg-dark text-white border-0 py-2.5 rounded-3 shadow-none" placeholder="نام..." />
                                <span asp-validation-for="FirstName" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small text-secondary fw-bold">نام خانوادگی</label>
                                <input asp-for="LastName" class="form-control bg-dark text-white border-0 py-2.5 rounded-3 shadow-none" placeholder="نام خانوادگی..." />
                                <span asp-validation-for="LastName" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small text-secondary fw-bold">شماره موبایل (غیرقابل تغییر)</label>
                                <input asp-for="PhoneNumber" class="form-control bg-dark text-secondary border-0 py-2.5 rounded-3 shadow-none" disabled />
                                <input type="hidden" asp-for="PhoneNumber" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small text-secondary fw-bold">ایمیل</label>
                                <input asp-for="Email" class="form-control bg-dark text-white border-0 py-2.5 rounded-3 shadow-none" placeholder="example@email.com" />
                                <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small text-secondary fw-bold">کد ملی (۱۰ رقم)</label>
                                <input asp-for="NationalId" class="form-control bg-dark text-white border-0 py-2.5 rounded-3 shadow-none" placeholder="0012345678" maxlength="10" />
                                <span asp-validation-for="NationalId" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label small text-secondary fw-bold">تاریخ تولد</label>
                                <input asp-for="BirthDate" type="date" class="form-control bg-dark text-white border-0 py-2.5 rounded-3 shadow-none" />
                                <span asp-validation-for="BirthDate" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>

                        <div class="mt-5 pt-3 border-top border-secondary border-opacity-25 text-end">
                            <button type="submit" class="btn btn-primary px-5 rounded-3 fw-bold py-3 shadow-lg bg-gradient border-0" style="background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);">
                                ذخیره و به‌روزرسانی پروفایل ✨
                            </button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>