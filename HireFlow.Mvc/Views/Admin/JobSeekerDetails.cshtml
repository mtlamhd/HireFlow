@model HireFlow.Domain.Dtos.AdminDto.AdminJobSeekerDetailsDto
@{
    ViewData["Title"] = "جزئیات پرونده کارجو";
}

<div style="background-color: #0b0f19; min-height: 100vh; color: #f8fafc; padding: 3rem 0;">
    <div class="container" style="max-width: 900px;">
        
        <!-- هدر -->
        <div class="d-flex justify-content-between align-items-center mb-5 pb-3 border-bottom border-secondary border-opacity-15">
            <div>
                <span class="badge px-3 py-2 rounded-pill fw-bold mb-2 shadow-sm" style="background: rgba(99, 102, 241, 0.15); color: #818cf8;">👑 پرونده کارجو</span>
                <h1 class="fw-bold text-white mb-0">جزئیات حساب کاربری و مهارت‌ها</h1>
            </div>
            <a asp-action="JobSeekers" class="btn btn-outline-light rounded-pill px-4 py-2 border-0 shadow-sm" style="background: rgba(255,255,255,0.05);">← بازگشت به لیست کارجویان</a>
        </div>

        <!-- پیام‌ها -->
        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-lg mb-4 border-0" role="alert" style="background: rgba(52, 211, 153, 0.15); color: #34d399;">
                ✨ @TempData["Message"]
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-lg mb-4 border-0" role="alert" style="background: rgba(239, 68, 68, 0.15); color: #f87171;">
                ⚠️ @TempData["Error"]
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5 mb-4" style="background: #1e293b; border: 1px solid rgba(255,255,255,0.06) !important;">
            
            <!-- اطلاعات هویتی کارجو -->
            <div class="d-flex justify-content-between align-items-center pb-4 mb-4 border-bottom border-secondary border-opacity-25">
                <div>
                    <h3 class="fw-bold text-white mb-1">🎯 @Model.FullName</h3>
                    <p class="text-secondary mb-0">شماره موبایل / نام کاربری: <span class="font-monospace text-light">@Model.Username</span></p>
                </div>
                <div>
                    @if (Model.IsActive)
                    {
                        <span class="badge rounded-pill px-4 py-2 fs-6 fw-bold" style="background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3);">
                            🟢 حساب فعال
                        </span>
                    }
                    else
                    {
                        <span class="badge rounded-pill px-4 py-2 fs-6 fw-bold" style="background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3);">
                            🔴 حساب غیرفعال
                        </span>
                    }
                </div>
            </div>

            <!-- مشخصات فردی -->
            <div class="row g-4 mb-5">
                <div class="col-md-4">
                    <div class="p-3 rounded-4 bg-dark bg-opacity-50 border border-secondary border-opacity-10">
                        <span class="text-secondary small d-block mb-1">ایمیل شخصی</span>
                        <span class="fw-bold text-white">@(string.IsNullOrEmpty(Model.Email) ? "ثبت نشده" : Model.Email)</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 rounded-4 bg-dark bg-opacity-50 border border-secondary border-opacity-10">
                        <span class="text-secondary small d-block mb-1">کد ملی</span>
                        <span class="fw-bold text-white @(string.IsNullOrEmpty(Model.NationalId) ? "" : "font-monospace")">
                            @(string.IsNullOrEmpty(Model.NationalId) ? "ثبت نشده" : Model.NationalId)
                        </span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 rounded-4 bg-dark bg-opacity-50 border border-secondary border-opacity-10">
                        <span class="text-secondary small d-block mb-1">سن کارجو</span>
                        <span class="fw-bold text-white">@(Model.Age.HasValue ? $"{Model.Age.Value} ساله" : "ثبت نشده")</span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 rounded-4 bg-dark bg-opacity-50 border border-secondary border-opacity-10">
                        <span class="text-secondary small d-block mb-1">تاریخ تولد</span>
                        <span class="fw-bold text-white">@(Model.BirthDate.HasValue ? Model.BirthDate.Value.ToString("yyyy/MM/dd") : "ثبت نشده")</span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 rounded-4 bg-dark bg-opacity-50 border border-secondary border-opacity-10">
                        <span class="text-secondary small d-block mb-1">تاریخ ثبت‌نام در پلتفرم</span>
                        <span class="fw-bold text-white">@Model.CreatedAt.ToString("yyyy/MM/dd")</span>
                    </div>
                </div>
            </div>

            <!-- بخش رزومه PDF کارجو -->
            <div class="p-4 rounded-4 mb-4" style="background: rgba(99, 102, 241, 0.1); border: 1px solid rgba(99, 102, 241, 0.2);">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold text-white mb-1">📄 رزومه شغلی کارجو (PDF)</h5>
                        <p class="text-secondary small mb-0">نام فایل: @(string.IsNullOrEmpty(Model.ResumeFileName) ? "ثبت نشده" : Model.ResumeFileName)</p>
                    </div>
                    @if (Model.ResumeId.HasValue && Model.ResumeId.Value != Guid.Empty)
                    {
                        <a asp-action="GetAttachment" asp-route-id="@Model.ResumeId" target="_blank" class="btn btn-primary rounded-3 px-4 py-2 fw-bold shadow-sm bg-gradient border-0" style="background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);">
                            دانلود / مشاهده رزومه 📥
                        </a>
                    }
                    else
                    {
                        <span class="badge bg-danger bg-opacity-20 text-danger px-3 py-2 rounded-3">این کارجو هنوز رزومه‌ای بارگذاری نکرده است</span>
                    }
                </div>
            </div>

            <!-- مهارت‌های تخصصی کارجو -->
            <div class="p-4 rounded-4 mb-4 bg-dark bg-opacity-50 border border-secondary border-opacity-10">
                <span class="text-secondary small d-block mb-2">⚡ مهارت‌های تخصصی ثبت‌شده:</span>
                @if (Model.Skills != null && Model.Skills.Any())
                {
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var skill in Model.Skills)
                        {
                            <span class="badge bg-secondary bg-opacity-25 text-light px-3 py-1.5 rounded-pill">📌 @skill.Name</span>
                        }
                    </div>
                }
                else
                {
                    <p class="text-light text-opacity-50 small mb-0">مهارتی ثبت نشده است.</p>
                }
            </div>

            <!-- دکمه‌های عملیاتی ادمین (فعال / غیرفعال‌سازی اکانت) -->
            <div class="border-top border-secondary border-opacity-25 pt-4 d-flex justify-content-end gap-3">
                @if (Model.IsActive)
                {
                    <form asp-action="DeactivateJobSeeker" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('آیا از غیرفعال‌سازی این حساب کاربری اطمینان دارید؟');">
                        <button type="submit" class="btn btn-outline-danger fw-bold px-5 py-3 rounded-3 shadow-sm">
                            🔴 غیرفعال‌سازی حساب کارجو
                        </button>
                    </form>
                }
                else
                {
                    <form asp-action="ActivateJobSeeker" asp-route-id="@Model.Id" method="post">
                        <button type="submit" class="btn btn-success fw-bold px-5 py-3 rounded-3 shadow-lg">
                            🟢 فعال‌سازی حساب کارجو
                        </button>
                    </form>
                }
            </div>

        </div>

    </div>
</div>