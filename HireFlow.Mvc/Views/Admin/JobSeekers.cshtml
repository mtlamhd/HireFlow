@model List<HireFlow.Domain.Dtos.AdminDto.AdminJobSeekerSummaryDto>
@{
    ViewData["Title"] = "مدیریت کارجویان";
}

<div style="background-color: #0b0f19; min-height: 100vh; color: #f8fafc; padding: 3rem 0;">
    <div class="container">
        
        <!-- هدر -->
        <div class="d-flex justify-content-between align-items-center mb-5 pb-3 border-bottom border-secondary border-opacity-15">
            <div>
                <span class="badge px-3 py-2 rounded-pill fw-bold mb-2 shadow-sm" style="background: rgba(99, 102, 241, 0.15); color: #818cf8;">👑 پنل مدیریت ادمین</span>
                <h1 class="fw-bold text-white mb-0">مدیریت کارجویان پلتفرم</h1>
            </div>
            <a asp-action="Dashboard" class="btn btn-outline-light rounded-pill px-4 py-2 border-0 shadow-sm" style="background: rgba(255,255,255,0.05);">← بازگشت به داشبورد</a>
        </div>

        <!-- پیام‌ها -->
        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-lg mb-4 border-0" role="alert" style="background: rgba(52, 211, 153, 0.15); color: #34d399;">
                ✨ @TempData["Message"]
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-lg mb-4 border-0" role="alert" style="background: rgba(239, 68, 68, 0.15); color: #f87171;">
                ⚠️ @TempData["Error"]
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5" style="background: #1e293b; border: 1px solid rgba(255,255,255,0.06) !important;">
            <h4 class="fw-bold text-white mb-4">لیست تمامی کارجویان ثبت‌نامی</h4>

            @if (Model == null || !Model.Any())
            {
                <div class="text-center py-5">
                    <div class="display-4 mb-3">📭</div>
                    <h5 class="text-white fw-bold">هنوز هیچ کارجویی در سیستم ثبت‌نام نکرده است.</h5>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle mb-0" style="background: transparent;">
                        <thead>
                            <tr class="text-secondary border-bottom border-secondary border-opacity-25 small">
                                <th class="py-3">نام و نام خانوادگی / نام کاربری</th>
                                <th class="py-3">ایمیل</th>
                                <th class="py-3">وضعیت حساب</th>
                                <th class="py-3">تاریخ ثبت‌نام</th>
                                <th class="py-3 text-end">عملیات ادمین</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var js in Model)
                            {
                                <tr style="border-bottom: 1px solid rgba(255,255,255,0.04);">
                                    <td class="py-3 fw-bold text-white">
                                        🎯 @js.FullName
                                        <div class="small text-secondary fw-normal">📞 @js.Username</div>
                                    </td>
                                    <td class="py-3 text-light">
                                        @(string.IsNullOrEmpty(js.Email) ? "ثبت نشده" : js.Email)
                                    </td>
                                    <td class="py-3">
                                        @if (js.IsActive)
                                        {
                                            <span class="badge rounded-pill px-3 py-1.5 fw-bold" style="background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3);">
                                                🟢 فعال
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill px-3 py-1.5 fw-bold" style="background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3);">
                                                🔴 غیرفعال
                                            </span>
                                        }
                                    </td>
                                    <td class="py-3 small text-light text-opacity-75">
                                        📅 @js.CreatedAt.ToString("yyyy/MM/dd")
                                    </td>
                                    <td class="py-3 text-end">
                                        <div class="d-flex gap-2 justify-content-end">
                                            
                                            <!-- دکمه جزئیات -->
                                            <a asp-action="JobSeekerDetails" asp-route-id="@js.Id" class="btn btn-sm btn-outline-info rounded-3 px-3" title="مشاهده جزئیات">
                                                👁️ جزئیات
                                            </a>

                                            <!-- دکمه فعال / غیرفعال‌سازی -->
                                            @if (js.IsActive)
                                            {
                                                <form asp-action="DeactivateJobSeeker" asp-route-id="@js.Id" method="post" class="d-inline" onsubmit="return confirm('آیا از غیرفعال‌سازی این کارجو اطمینان دارید؟');">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-3 px-3 fw-bold" title="غیرفعال‌سازی">
                                                        ⏸️ غیرفعال
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-action="ActivateJobSeeker" asp-route-id="@js.Id" method="post" class="d-inline">
                                                    <button type="submit" class="btn btn-sm btn-outline-success rounded-3 px-3 fw-bold" title="فعال‌سازی">
                                                        ▶️ فعال‌سازی
                                                    </button>
                                                </form>
                                            }

                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

    </div>
</div>