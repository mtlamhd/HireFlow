@model HireFlow.Domain.Dtos.AdminDto.AdminJobAdDetailsDto
@{
    ViewData["Title"] = "جزئیات آگهی استخدام";
}

<div style="background-color: #0b0f19; min-height: 100vh; color: #f8fafc; padding: 3rem 0;">
    <div class="container" style="max-width: 900px;">
        
        <!-- هدر -->
        <div class="d-flex justify-content-between align-items-center mb-5 pb-3 border-bottom border-secondary border-opacity-15">
            <div>
                <span class="badge px-3 py-2 rounded-pill fw-bold mb-2 shadow-sm" style="background: rgba(99, 102, 241, 0.15); color: #818cf8;">👑 ممیزی آگهی</span>
                <h1 class="fw-bold text-white mb-0">جزئیات کامل فرصت شغلی</h1>
            </div>
            <a asp-action="JobAds" class="btn btn-outline-light rounded-pill px-4 py-2 border-0 shadow-sm" style="background: rgba(255,255,255,0.05);">← بازگشت به لیست آگهی‌ها</a>
        </div>

        <!-- پیام‌ها -->
        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-lg mb-4 border-0" role="alert" style="background: rgba(52, 211, 153, 0.15); color: #34d399;">
                ✨ @TempData["Message"]
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-lg mb-4 border-0" role="alert" style="background: rgba(239, 68, 68, 0.15); color: #f87171;">
                ⚠️ @TempData["Error"]
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5 mb-4" style="background: #1e293b; border: 1px solid rgba(255,255,255,0.06) !important;">
            
            <!-- عنوان آگهی و وضعیت‌ها -->
            <div class="d-flex justify-content-between align-items-start pb-4 mb-4 border-bottom border-secondary border-opacity-25 gap-3">
                <div>
                    <h2 class="fw-bold text-white mb-2">💼 @Model.Title</h2>
                    <p class="text-secondary mb-0">انتشاریافته در تاریخ: @Model.CreatedAt.ToString("yyyy/MM/dd") | تاریخ انقضا: <span class="text-warning">@Model.ExpireAt.ToString("yyyy/MM/dd")</span></p>
                </div>
                <div class="d-flex flex-column gap-2 text-md-end">
                    @if (Model.IsActive)
                    {
                        <span class="badge rounded-pill px-3 py-1.5 fw-bold" style="background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3);">
                            🟢 آگهی فعال
                        </span>
                    }
                    else
                    {
                        <span class="badge rounded-pill px-3 py-1.5 fw-bold" style="background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3);">
                            🔴 آگهی غیرفعال
                        </span>
                    }

                    @if (Model.IsFeaturedActive)
                    {
                        <span class="badge rounded-pill px-3 py-1.5 fw-bold" style="background: rgba(245, 158, 11, 0.15); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.3);">
                            ⭐ آگهی ویژه (تا @Model.FeaturedUntil?.ToString("yyyy/MM/dd"))
                        </span>
                    }
                </div>
            </div>

            <!-- اطلاعات شرکت منتشرکننده -->
            <div class="p-4 rounded-4 mb-4 d-flex align-items-center gap-4" style="background: rgba(249, 115, 22, 0.05); border: 1px solid rgba(249, 115, 22, 0.2);">
                @if (Model.CompanyLogoId.HasValue && Model.CompanyLogoId.Value != Guid.Empty)
                {
                    <img src="@Url.Action("GetAttachment", "Admin", new { id = Model.CompanyLogoId })" class="rounded-4 shadow-lg" style="width: 70px; height: 70px; object-fit: cover; border: 2px solid rgba(249, 115, 22, 0.5);" alt="Company Logo" />
                }
                else
                {
                    <div class="rounded-4 d-flex align-items-center justify-content-center fw-bold text-white shadow-lg" style="width: 70px; height: 70px; background: linear-gradient(135deg, #f97316 0%, #ea580c 100%); font-size: 24px;">
                        🏢
                    </div>
                }
                <div>
                    <span class="text-secondary small d-block mb-1">شرکت منتشرکننده آگهی</span>
                    <h4 class="fw-bold text-white mb-0">@Model.CompanyName</h4>
                </div>
            </div>

            <!-- جزئیات تکمیلی آگهی -->
            <div class="row g-4 mb-5">
                <div class="col-md-4">
                    <div class="p-3 rounded-4 bg-dark bg-opacity-50 border border-secondary border-opacity-10">
                        <span class="text-secondary small d-block mb-1">استان و شهر</span>
                        <span class="fw-bold text-white">📍 @Model.ProvinceName، @Model.CityName</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 rounded-4 bg-dark bg-opacity-50 border border-secondary border-opacity-10">
                        <span class="text-secondary small d-block mb-1">دسته‌بندی شغلی</span>
                        <span class="fw-bold text-white">🏷️ @Model.CategoryName</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 rounded-4 bg-dark bg-opacity-50 border border-secondary border-opacity-10">
                        <span class="text-secondary small d-block mb-1">نوع همکاری</span>
                        <span class="fw-bold text-white">💼 @Model.EmploymentType</span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 rounded-4 bg-dark bg-opacity-50 border border-secondary border-opacity-10">
                        <span class="text-secondary small d-block mb-1">حقوق و دستمزد ماهیانه</span>
                        <span class="fw-bold text-success font-monospace">@(Model.Salary.HasValue ? $"{Model.Salary.Value:N0} تومان" : "توافقی")</span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 rounded-4 bg-dark bg-opacity-50 border border-secondary border-opacity-10">
                        <span class="text-secondary small d-block mb-1">وضعیت برجسته‌سازی (Highlight)</span>
                        <span class="fw-bold text-info">@(Model.IsHighlighted ? "برجسته و سنجاق‌شده ⚡" : "عادی")</span>
                    </div>
                </div>
            </div>

            <!-- مهارت‌های مورد نیاز -->
            <div class="p-4 rounded-4 mb-4 bg-dark bg-opacity-50 border border-secondary border-opacity-10">
                <span class="text-secondary small d-block mb-2">⚡ مهارت‌های تخصصی مورد نیاز برای این شغل:</span>
                @if (Model.Skills != null && Model.Skills.Any())
                {
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var skill in Model.Skills)
                        {
                            <span class="badge bg-secondary bg-opacity-25 text-light px-3 py-1.5 rounded-pill">📌 @skill.Name</span>
                        }
                    </div>
                }
                else
                {
                    <p class="text-light text-opacity-50 small mb-0">مهارتی ثبت نشده است.</p>
                }
            </div>

            <!-- شرح موقعیت شغلی -->
            <div class="p-4 rounded-4 mb-5 bg-dark bg-opacity-50 border border-secondary border-opacity-10">
                <span class="text-secondary small d-block mb-2">📄 شرح موقعیت شغلی و شرایط احراز:</span>
                <div class="text-light text-opacity-90" style="white-space: pre-line; line-height: 1.8;">@Model.Description</div>
            </div>

            <!-- دکمه‌های مدیریتی ادمین -->
            <div class="border-top border-secondary border-opacity-25 pt-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
                
                <div class="d-flex gap-2">
                    <!-- فعال / غیرفعال -->
                    <form asp-action="@(Model.IsActive ? "DeactivateJobAd" : "ActivateJobAd")" asp-route-id="@Model.Id" method="post">
                        @if (Model.IsActive)
                        {
                            <button type="submit" class="btn btn-outline-warning fw-bold px-4 py-2.5 rounded-3 shadow-sm">
                                ⏸️ غیرفعال‌سازی آگهی
                            </button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-success fw-bold px-4 py-2.5 rounded-3 shadow-sm">
                                ▶️ فعال‌سازی آگهی
                            </button>
                        }
                    </form>

                    <!-- ویژه کردن / لغو ویژه -->
                    @if (Model.IsFeaturedActive)
                    {
                        <form asp-action="CancelFeatured" asp-route-id="@Model.Id" method="post">
                            <button type="submit" class="btn btn-outline-secondary fw-bold px-4 py-2.5 rounded-3 shadow-sm">
                                ⭐ لغو وضعیت ویژه
                            </button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="MakeFeatured" asp-route-id="@Model.Id" method="post">
                            <input type="hidden" name="featuredUntil" value="@DateTime.UtcNow.AddDays(7).ToString("yyyy-MM-ddTHH:mm")" />
                            <button type="submit" class="btn btn-warning fw-bold px-4 py-2.5 rounded-3 shadow-sm">
                                ⭐ ویژه کردن آگهی (۷ روزه)
                            </button>
                        </form>
                    }
                </div>

                <!-- حذف نرم‌افزاری -->
                <form asp-action="SoftDeleteJobAd" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('آیا از حذف این آگهی اطمینان دارید؟');">
                    <button type="submit" class="btn btn-outline-danger fw-bold px-4 py-2.5 rounded-3 shadow-sm">
                        🗑️ حذف آگهی (Soft Delete)
                    </button>
                </form>

            </div>

        </div>

    </div>
</div>