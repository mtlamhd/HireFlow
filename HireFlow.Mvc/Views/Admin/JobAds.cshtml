@model List<HireFlow.Domain.Dtos.AdminDto.AdminJobAdSummaryDto>
@{
    ViewData["Title"] = "مدیریت آگهی‌های استخدام";
}

<div style="background-color: #0b0f19; min-height: 100vh; color: #f8fafc; padding: 3rem 0;">
    <div class="container">
        
        <!-- هدر -->
        <div class="d-flex justify-content-between align-items-center mb-5 pb-3 border-bottom border-secondary border-opacity-15">
            <div>
                <span class="badge px-3 py-2 rounded-pill fw-bold mb-2 shadow-sm" style="background: rgba(99, 102, 241, 0.15); color: #818cf8;">👑 پنل مدیریت ادمین</span>
                <h1 class="fw-bold text-white mb-0">مدیریت آگهی‌های استخدامی کل پلتفرم</h1>
            </div>
            <a asp-action="Dashboard" class="btn btn-outline-light rounded-pill px-4 py-2 border-0 shadow-sm" style="background: rgba(255,255,255,0.05);">← بازگشت به داشبورد</a>
        </div>

        <!-- پیام‌ها -->
        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-lg mb-4 border-0" role="alert" style="background: rgba(52, 211, 153, 0.15); color: #34d399;">
                ✨ @TempData["Message"]
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-lg mb-4 border-0" role="alert" style="background: rgba(239, 68, 68, 0.15); color: #f87171;">
                ⚠️ @TempData["Error"]
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5" style="background: #1e293b; border: 1px solid rgba(255,255,255,0.06) !important;">
            <h4 class="fw-bold text-white mb-4">لیست تمامی آگهی‌های ثبت‌شده در سیستم</h4>

            @if (Model == null || !Model.Any())
            {
                <div class="text-center py-5">
                    <div class="display-4 mb-3">📭</div>
                    <h5 class="text-white fw-bold">هنوز هیچ آگهی استخدامی در پلتفرم ثبت نشده است.</h5>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle mb-0" style="background: transparent;">
                        <thead>
                            <tr class="text-secondary border-bottom border-secondary border-opacity-25 small">
                                <th class="py-3">عنوان شغلی / شرکت</th>
                                <th class="py-3">شهر / دسته‌بندی</th>
                                <th class="py-3">وضعیت / ویژه</th>
                                <th class="py-3">درخواست‌ها</th>
                                <th class="py-3 text-end">عملیات ادمین</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ad in Model)
                            {
                                <tr style="border-bottom: 1px solid rgba(255,255,255,0.04);">
                                    <td class="py-3 fw-bold text-white">
                                        💼 @ad.Title
                                        <div class="small text-secondary fw-normal">🏢 شرکت: @ad.CompanyName</div>
                                        <div class="small text-light text-opacity-50 fw-normal">📅 انقضا: @ad.ExpireAt.ToString("yyyy/MM/dd")</div>
                                    </td>
                                    <td class="py-3 small text-secondary">
                                        <div>📍 @ad.CityName</div>
                                        <div>🏷️ @ad.CategoryName</div>
                                    </td>
                                    <td class="py-3">
                                        <div class="d-flex flex-column gap-1">
                                            @if (ad.IsActive)
                                            {
                                                <span class="badge rounded-pill px-2.5 py-1 fw-bold text-center" style="background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3); font-size: 11px;">
                                                    🟢 فعال
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge rounded-pill px-2.5 py-1 fw-bold text-center" style="background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3); font-size: 11px;">
                                                    🔴 غیرفعال
                                                </span>
                                            }

                                            @if (ad.IsFeatured && ad.FeaturedUntil.HasValue && ad.FeaturedUntil.Value > DateTime.UtcNow)
                                            {
                                                <span class="badge rounded-pill px-2.5 py-1 fw-bold text-center" style="background: rgba(245, 158, 11, 0.15); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.3); font-size: 11px;">
                                                    ⭐ ویژه (تا @ad.FeaturedUntil.Value.ToString("MM/dd"))
                                                </span>
                                            }
                                        </div>
                                    </td>
                                    <td class="py-3">
                                        <span class="badge rounded-pill px-3 py-1.5 fw-bold" style="background: rgba(59, 130, 246, 0.15); color: #60a5fa; border: 1px solid rgba(59, 130, 246, 0.3);">
                                            👥 @ad.ApplicationsCount درخواست
                                        </span>
                                    </td>
                                    <td class="py-3 text-end">
                                        <div class="d-flex gap-2 justify-content-end align-items-center">
                                            
                                            <!-- جزئیات -->
                                            <a asp-action="JobAdDetails" asp-route-id="@ad.Id" class="btn btn-sm btn-outline-info rounded-3 px-3" title="مشاهده جزئیات">
                                                👁️ جزئیات
                                            </a>

                                            <!-- فعال / غیرفعال‌سازی -->
                                            <form asp-action="@(ad.IsActive ? "DeactivateJobAd" : "ActivateJobAd")" asp-route-id="@ad.Id" method="post" class="d-inline">
                                                @if (ad.IsActive)
                                                {
                                                    <button type="submit" class="btn btn-sm btn-outline-secondary rounded-3 px-2" title="غیرفعال‌سازی">
                                                        ⏸️
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit" class="btn btn-sm btn-outline-success rounded-3 px-2" title="فعال‌سازی">
                                                        ▶️
                                                    </button>
                                                }
                                            </form>

                                            <!-- ویژه کردن / لغو ویژه -->
                                            @if (ad.IsFeatured && ad.FeaturedUntil.HasValue && ad.FeaturedUntil.Value > DateTime.UtcNow)
                                            {
                                                <form asp-action="CancelFeatured" asp-route-id="@ad.Id" method="post" class="d-inline" onsubmit="return confirm('آیا از لغو وضعیت ویژه این آگهی اطمینان دارید؟');">
                                                    <button type="submit" class="btn btn-sm btn-warning rounded-3 px-2 fw-bold" title="لغو ویژه">
                                                        ⭐ لغو
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-action="MakeFeatured" asp-route-id="@ad.Id" method="post" class="d-inline">
                                                    <input type="hidden" name="featuredUntil" value="@DateTime.UtcNow.AddDays(7).ToString("yyyy-MM-ddTHH:mm")" />
                                                    <button type="submit" class="btn btn-sm btn-outline-warning rounded-3 px-2" title="ویژه کردن (۷ روزه)">
                                                        ⭐ ویژه
                                                    </button>
                                                </form>
                                            }

                                            <!-- حذف نرم‌افزاری -->
                                            <form asp-action="SoftDeleteJobAd" asp-route-id="@ad.Id" method="post" class="d-inline" onsubmit="return confirm('آیا از حذف این آگهی اطمینان دارید؟');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-3 px-2" title="حذف آگهی">
                                                    🗑️
                                                </button>
                                            </form>

                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

    </div>
</div>