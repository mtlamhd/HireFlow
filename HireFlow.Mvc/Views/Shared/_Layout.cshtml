@using Microsoft.AspNetCore.Identity
@using HireFlow.Domain.Entities
@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HireFlow</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css" rel="stylesheet" type="text/css" />
    <style>
        body {
            font-family: 'Vazirmatn', sans-serif !important;
            background-color: #0b0f19;
            color: #f8fafc;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">

    <!-- هدر شیشه‌ای شناور (Navbar) -->
    <nav class="navbar navbar-expand-lg navbar-dark fixed-top" style="background: rgba(11, 15, 25, 0.85); backdrop-filter: blur(16px); border-bottom: 1px solid rgba(255, 255, 255, 0.08);">
        <div class="container">
            <a class="navbar-brand fw-bold fs-4 d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                <span class="bg-gradient p-2 rounded-3 text-white shadow-sm" style="background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%); font-size: 16px;">⚡</span>
                <span style="letter-spacing: -1px; background: linear-gradient(135deg, #fff 0%, #94a3b8 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">HireFlow</span>
            </a>
            
            <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-2">
                    <li class="nav-item">
                        <a class="nav-link text-light px-3 rounded-pill hover-glass" asp-controller="Home" asp-action="Index">فرصت‌های شغلی</a>
                    </li>
                </ul>

                <div class="d-flex align-items-center gap-3">
                    
                    <!-- ☀️🌙 دکمه سوییچ تم (تاریک / روشن) -->
                    <button id="themeToggleBtn" class="btn btn-outline-light rounded-circle p-0 d-flex align-items-center justify-content-center shadow-sm" style="width: 40px; height: 40px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); flex-shrink: 0;" title="تغییر تم (تاریک / روشن)">
                        🌙
                    </button>

                    @if (SignInManager.IsSignedIn(User))
                    {
                        var currentUser = await UserManager.GetUserAsync(User);
                        var roles = await UserManager.GetRolesAsync(currentUser);
                        
                        <div class="dropdown">
                            <button class="btn btn-outline-light rounded-pill px-4 py-2 border-0 dropdown-toggle" style="background: rgba(255,255,255,0.05);" type="button" data-bs-toggle="dropdown">
                                👤 حساب کاربری
                            </button>
                            <ul class="dropdown-menu dropdown-menu-dark shadow-lg rounded-4 border-0 mt-2 p-2" style="background: #1e293b;">
                                @if (roles.Contains("Admin"))
                                {
                                    <li><a class="dropdown-item rounded-3 py-2" asp-controller="Admin" asp-action="Dashboard">📊 داشبورد ادمین</a></li>
                                    <li><a class="dropdown-item rounded-3 py-2" asp-controller="Admin" asp-action="Employers">👑 مدیریت کارفرمایان</a></li>
                                    <li><a class="dropdown-item rounded-3 py-2" asp-controller="Admin" asp-action="JobSeekers">🎯 مدیریت کارجویان</a></li>
                                    <li><a class="dropdown-item rounded-3 py-2" asp-controller="Admin" asp-action="JobAds">💼 مدیریت آگهی‌ها</a></li>
                                    <li><a class="dropdown-item rounded-3 py-2" asp-controller="Admin" asp-action="EmailTemplates">✉️ مدیریت قالب‌های ایمیل</a></li>
                                }
                                else if (roles.Contains("Employer"))
                                {
                                    <li><a class="dropdown-item rounded-3 py-2" asp-controller="Employer" asp-action="Profile">👤 مشخصات فردی من</a></li>
                                    <li><a class="dropdown-item rounded-3 py-2" asp-controller="Employer" asp-action="Company">🏢 مدیریت اطلاعات شرکت</a></li>
                                    <li><a class="dropdown-item rounded-3 py-2" asp-controller="Employer" asp-action="JobAds">💼 آگهی‌های استخدامی من</a></li>
                                }
                                else
                                {
                                    <li><a class="dropdown-item rounded-3 py-2" asp-controller="JobSeeker" asp-action="Profile">🎯 ویرایش پروفایل</a></li>
                                    <li><a class="dropdown-item rounded-3 py-2" asp-controller="JobSeeker" asp-action="MyRequests">📋 درخواست‌های من</a></li>
                                }
                                <li><hr class="dropdown-divider opacity-25"></li>
                                <li>
                                    <form asp-controller="Auth" asp-action="Logout" method="post">
                                        <button type="submit" class="dropdown-item text-danger rounded-3 py-2">خروج از سیستم</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Auth" asp-action="Login" class="btn btn-outline-light rounded-pill px-4 py-2 border-0 fw-semibold" style="background: rgba(255,255,255,0.05);">ورود</a>
                        <a asp-controller="Auth" asp-action="RegisterJobSeeker" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow bg-gradient border-0" style="background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);">ثبت‌نام رایگان</a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <!-- محتوای اصلی صفحات -->
    <main class="flex-shrink-0" style="margin-top: 76px;">
        @RenderBody()
    </main>

    <!-- فوتر مدرن -->
    <footer class="mt-auto py-4 text-center text-secondary small border-top border-secondary border-opacity-15" style="background: #0b0f19;">
        <div class="container">
            <p class="mb-0">تمامی حقوق برای پلتفرم کاریابی <span class="text-white fw-bold">HireFlow</span> محفوظ است © ۱۴۰۳</p>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <!-- اسکریپت و استایل‌های سوییچ تم (دیفالت = دارک مود) -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const toggleBtn = document.getElementById('themeToggleBtn');
            const body = document.body;

            const savedTheme = localStorage.getItem('hireflow_theme');
            if (savedTheme === 'light') {
                body.classList.add('light-mode');
                if (toggleBtn) toggleBtn.textContent = '☀️';
            } else {
                body.classList.remove('light-mode');
                if (toggleBtn) toggleBtn.textContent = '🌙';
                if (!savedTheme) {
                    localStorage.setItem('hireflow_theme', 'dark');
                }
            }

            if (toggleBtn) {
                toggleBtn.addEventListener('click', function () {
                    body.classList.toggle('light-mode');
                    if (body.classList.contains('light-mode')) {
                        localStorage.setItem('hireflow_theme', 'light');
                        this.textContent = '☀️';
                    } else {
                        localStorage.setItem('hireflow_theme', 'dark');
                        this.textContent = '🌙';
                    }
                });
            }
        });
    </script>

    <style>
        .hover-glass:hover {
            background: rgba(255, 255, 255, 0.05);
        }

        /* انیمیشن نرم موقع تغییر تم */
        body, .card, .navbar, .form-control, .form-select, .btn {
            transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease !important;
        }

        /* 🌟 استایل‌های حالت روشن (Light Mode) با اصلاح صددرصدی دراپ‌داون‌ها و فیلترها */
        body.light-mode {
            background-color: #f1f5f9 !important;
            color: #0f172a !important;
        }

        body.light-mode p,
        body.light-mode span,
        body.light-mode h1, body.light-mode h2, body.light-mode h3, body.light-mode h4, body.light-mode h5, body.light-mode h6,
        body.light-mode label,
        body.light-mode td,
        body.light-mode th,
        body.light-mode .text-secondary,
        body.light-mode .text-light,
        body.light-mode .form-text {
            color: #1e293b !important;
        }

        body.light-mode [style*="background-color: #0b0f19"],
        body.light-mode [style*="background: #0b0f19"] {
            background-color: #f8fafc !important;
            background: #f8fafc !important;
        }

        body.light-mode [style*="background: #1e293b"],
        body.light-mode [style*="background-color: #1e293b"],
        body.light-mode .card {
            background-color: #ffffff !important;
            background: #ffffff !important;
            border: 1px solid #e2e8f0 !important;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05) !important;
            color: #0f172a !important;
        }

        /* 🛠️ اصلاح ویژه برای اینپوت‌ها، سلکت‌ها و آپشن‌های فیلتر در حالت روشن */
        body.light-mode .form-control,
        body.light-mode .form-select,
        body.light-mode select,
        body.light-mode input,
        body.light-mode textarea,
        body.light-mode [style*="background: rgba(15, 23, 42"] {
            background-color: #ffffff !important;
            background: #ffffff !important;
            color: #0f172a !important;
            border: 1px solid #cbd5e1 !important;
        }

        /* اصلاح رنگ متن گزینه‌های دراپ‌داون (Options) */
        body.light-mode option {
            background-color: #ffffff !important;
            color: #0f172a !important;
        }

        body.light-mode .form-control::placeholder,
        body.light-mode textarea::placeholder {
            color: #94a3b8 !important;
        }

        body.light-mode .navbar {
            background: rgba(255, 255, 255, 0.85) !important;
            border-bottom: 1px solid rgba(0, 0, 0, 0.08) !important;
        }

        body.light-mode .table-dark {
            --bs-table-bg: #ffffff;
            --bs-table-color: #0f172a;
            color: #0f172a;
            border-color: #e2e8f0;
        }

        body.light-mode .btn-outline-light {
            color: #0f172a !important;
            border-color: #94a3b8 !important;
            background-color: #ffffff !important;
        }

        body.light-mode .btn-outline-light:hover {
            color: #ffffff !important;
            background-color: #0f172a !important;
            border-color: #0f172a !important;
        }

        body.light-mode .dropdown-menu {
            background-color: #ffffff !important;
            border: 1px solid rgba(0, 0, 0, 0.1) !important;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1) !important;
        }

        body.light-mode .dropdown-item {
            color: #0f172a !important;
        }

        body.light-mode .dropdown-item:hover {
            background-color: #f1f5f9 !important;
            color: #4f46e5 !important;
        }

        body.light-mode .dropdown-divider {
            border-color: #e2e8f0 !important;
            opacity: 1 !important;
        }
    </style>
</body>
</html>