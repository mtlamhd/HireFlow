@using HireFlow.Domain.Dtos.JobAdDto
@using HireFlow.Domain.Entities
@using HireFlow.Domain.Enums
@model List<HireFlow.Domain.Dtos.JobAdDto.PublicJobAdSummaryDto>
@{
    ViewData["Title"] = "فرصت‌های شغلی";
    var search = ViewBag.SearchModel as JobAdSearchDto ?? new JobAdSearchDto();
    var cities = ViewBag.Cities as List<City> ?? new List<City>();
    var categories = ViewBag.Categories as List<Category> ?? new List<Category>();
    var employmentTypes = ViewBag.EmploymentTypes as IEnumerable<dynamic> ?? new List<dynamic>();
}

<div style="background-color: #0b0f19; min-height: 100vh; color: #f8fafc; padding-bottom: 6rem; position: relative; overflow: hidden;">

    <!-- نورهای نئونی پس‌زمینه (Ambient Glow Background) -->
    <div style="position: absolute; top: -100px; left: 20%; width: 500px; height: 500px; background: radial-gradient(circle, rgba(99,102,241,0.15) 0%, rgba(0,0,0,0) 70%); filter: blur(60px); z-index: 0; pointer-events: none;"></div>
    <div style="position: absolute; top: 300px; right: 10%; width: 400px; height: 400px; background: radial-gradient(circle, rgba(14,165,233,0.1) 0%, rgba(0,0,0,0) 70%); filter: blur(60px); z-index: 0; pointer-events: none;"></div>

    <!-- هرو بنر مدرن -->
    <div class="position-relative overflow-hidden p-5 text-center" style="padding-top: 5rem !important; padding-bottom: 7rem !important; z-index: 1;">
        <div class="col-md-9 p-lg-5 mx-auto">
            <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-4 shadow-sm" style="background: rgba(99, 102, 241, 0.1); border: 1px solid rgba(99, 102, 241, 0.2);">
                <span class="animate-pulse" style="width: 8px; height: 8px; background: #6366f1; border-radius: 50%;"></span>
                <span class="small fw-bold" style="color: #818cf8;">پلتفرم استخدام هوشمند نسل جدید</span>
            </div>
            <h1 class="display-3 fw-bold mb-3 text-white" style="letter-spacing: -2.5px; line-height: 1.1;">مسیر حرفه‌ای‌ات را<br><span style="background: linear-gradient(135deg, #818cf8 0%, #c084fc 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">هوشمندانه انتخاب کن</span></h1>
            <p class="lead text-secondary mb-5 mx-auto" style="max-width: 600px; color: #94a3b8 !important;">از مالی و بازاریابی تا طراحی و مهندسی؛ صدها فرصت شغلی معتبر در انتظار توست.</p>
        </div>
    </div>

    <div class="container" style="margin-top: -4rem; position: relative; z-index: 10;">
        
        <!-- پنل جستجوی پیشرفته (Glassmorphism عمیق) -->
        <div class="card border-0 shadow-lg rounded-5 p-4 p-md-5 mb-5" style="background: rgba(30, 41, 59, 0.65); backdrop-filter: blur(24px); border: 1px solid rgba(255, 255, 255, 0.08) !important; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5) !important;">
            <form asp-action="Index" method="get" class="row g-3 align-items-center">
                
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-secondary mb-1">عنوان شغل یا تخصص</label>
                    <div class="input-group rounded-3 overflow-hidden" style="background: rgba(15, 23, 42, 0.8);">
                        <span class="input-group-text bg-transparent border-0 ps-3 text-secondary">🔍</span>
                        <input type="text" name="Title" value="@search.Title" class="form-control border-0 bg-transparent text-white py-2" placeholder="مثلا حسابدار، طراح..." style="box-shadow: none;" />
                    </div>
                </div>

                <div class="col-md-2">
                    <label class="form-label small fw-bold text-secondary mb-1">شهر محل کار</label>
                    <select name="CityId" class="form-select border-0 py-2 rounded-3 text-white" style="background: rgba(15, 23, 42, 0.8);">
                        <option value="" style="background: #0f172a;">📍 همه شهرها</option>
                        @foreach (var city in cities)
                        {
                            <option value="@city.Id" selected="@(search.CityId == city.Id)" style="background: #0f172a;">@city.Name</option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label small fw-bold text-secondary mb-1">دسته‌بندی شغلی</label>
                    <select name="CategoryId" class="form-select border-0 py-2 rounded-3 text-white" style="background: rgba(15, 23, 42, 0.8);">
                        <option value="" style="background: #0f172a;">📁 همه حوزه‌ها</option>
                        @foreach (var cat in categories)
                        {
                            <option value="@cat.Id" selected="@(search.CategoryId == cat.Id)" style="background: #0f172a;">@cat.Name</option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label small fw-bold text-secondary mb-1">نوع همکاری</label>
                    <select name="EmploymentType" class="form-select border-0 py-2 rounded-3 text-white" style="background: rgba(15, 23, 42, 0.8);">
                        <option value="" style="background: #0f172a;">💼 همه موارد</option>
                        @foreach (var type in employmentTypes)
                        {
                            <option value="@type.Value" selected="@(search.EmploymentType == (EmploymentTypeEnum)type.Value)" style="background: #0f172a;">@type.Name</option>
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label small fw-bold text-secondary mb-1">حداقل حقوق (تومان)</label>
                    <input type="number" name="MinSalary" value="@search.MinSalary" class="form-control border-0 py-2 rounded-3 text-white" style="background: rgba(15, 23, 42, 0.8);" placeholder="مثلا 15000000" />
                </div>

                <div class="col-md-12 text-end mt-4">
                    <button type="submit" class="btn btn-primary px-5 rounded-3 fw-bold py-3 shadow-lg bg-gradient border-0 w-100 w-md-auto" style="background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);">
                        🚀 فیلتر و جستجوی پیشرفته فرصت‌های شغلی
                    </button>
                </div>
            </form>
        </div>

        <!-- گرید آگهی‌ها -->
        <div class="row g-4">
            @if (Model == null || !Model.Any())
            {
                <div class="col-12 text-center py-5">
                    <div class="card border-0 shadow-lg rounded-4 p-5" style="background: #1e293b; border: 1px solid rgba(255,255,255,0.05) !important;">
                        <div class="display-1 mb-3">🛸</div>
                        <h3 class="fw-bold text-white">موقعیت شغلی‌ای با این مشخصات پیدا نشد!</h3>
                        <p class="text-secondary">لطفاً فیلترها را کمتر کنید یا بعداً سر بزنید.</p>
                    </div>
                </div>
            }
            else
            {
                @foreach (var job in Model)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card border-0 shadow-lg rounded-4 h-100 p-4 position-relative transition-card neon-hover d-flex flex-column" style="background: #1e293b; border: 1px solid rgba(255, 255, 255, 0.06) !important;">
                            
                            <!-- هدر کارت (آواتار شرکت و بج‌ها) -->
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-3 d-flex align-items-center justify-content-center fw-bold text-white shadow-sm" style="width: 45px; height: 45px; background: linear-gradient(135deg, #4f46e5 0%, #9333ea 100%); font-size: 18px;">
                                        @job.CompanyName.Substring(0, 1)
                                    </div>
                                    <div>
                                        <span class="fw-semibold small d-block" style="color: #cbd5e1;">@job.CompanyName</span>
                                        <span class="text-secondary" style="font-size: 11px;">📍 @job.CityName</span>
                                    </div>
                                </div>
                                <div class="d-flex gap-1">
                                    @if (job.IsFeatured)
                                    {
                                        <span class="badge rounded-pill px-2 py-1" style="background: rgba(239, 68, 68, 0.15); color: #f87171; font-size: 10px;">⭐ ویژه</span>
                                    }
                                    @if (job.IsHighlighted)
                                    {
                                        <span class="badge rounded-pill px-2 py-1" style="background: rgba(234, 179, 8, 0.15); color: #facc15; font-size: 10px;">🔥 داغ</span>
                                    }
                                </div>
                            </div>

                            <!-- عنوان شغل -->
                            <h4 class="fw-bold text-white mb-3 text-truncate" title="@job.Title">@job.Title</h4>

                            <!-- اطلاعات تکمیلی پایین کارت -->
                            <div class="mt-auto pt-3 border-top border-secondary border-opacity-25">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="badge rounded-pill px-3 py-2" style="background: rgba(255,255,255,0.04); color: #94a3b8; font-size: 11px;">📁 @job.CategoryName</span>
                                    <span class="fw-bold small" style="color: #34d399;">@(job.Salary.HasValue ? job.Salary.Value.ToString("N0") + " ت" : "توافقی")</span>
                                </div>

                                <a asp-action="Details" asp-route-id="@job.Id" class="btn btn-outline-light w-100 rounded-3 fw-bold py-2 shadow-sm transition-btn" style="border-color: rgba(255,255,255,0.12); font-size: 13px;">مشاهده جزئیات و ارسال رزومه</a>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

<style>
    .transition-card {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .neon-hover:hover {
        transform: translateY(-6px);
        background: #1e293b !important;
        border-color: #6366f1 !important;
        box-shadow: 0 20px 40px -15px rgba(99, 102, 241, 0.4) !important;
    }
    @@keyframes pulse {
        0% { transform: scale(0.95); opacity: 0.8; }
        50% { transform: scale(1.15); opacity: 1; }
        100% { transform: scale(0.95); opacity: 0.8; }
    }
    .animate-pulse {
        animation: pulse 2s infinite;
    }
</style>