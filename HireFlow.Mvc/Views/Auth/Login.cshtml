@model HireFlow.Mvc.Models.AuthView.LoginViewModel
@{
    ViewData["Title"] = "ورود به HireFlow";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="container-fluid min-vh-100 p-0 m-0" style="background-color: #0b0f19; overflow-x: hidden;">
    <div class="row g-0 min-vh-100">
        
        <!-- ستون راست: فرم لاگین (مدرن و شیشه‌ای) -->
        <div class="col-lg-5 col-md-6 d-flex align-items-center justify-content-center p-4 p-md-5" style="background: #0f172a; border-left: 1px solid rgba(255,255,255,0.05); position: relative; z-index: 2;">
            <div class="w-100" style="max-width: 400px;">
                
                <!-- هدر فرم -->
                <div class="mb-4">
                    <a asp-controller="Home" asp-action="Index" class="text-decoration-none d-inline-flex align-items-center gap-2 mb-3">
                        <span class="p-2 rounded-3 text-white shadow" style="background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);">⚡</span>
                        <span class="fw-bold fs-4 text-white">HireFlow</span>
                    </a>
                    <h3 class="fw-bold text-white mb-1">خوش آمدید! 👋</h3>
                    <p class="text-secondary small">لطفاً برای ورود به حساب کاربری خود اطلاعات زیر را وارد کنید.</p>
                </div>

                @if (TempData["Message"] != null)
                {
                    <div class="alert rounded-4 p-3 mb-4 text-center fw-bold shadow-sm border-0 small" style="background: rgba(52, 211, 153, 0.15); color: #34d399;">
                        ✨ @TempData["Message"]
                    </div>
                }

                <form asp-action="Login" method="post">
                    <div asp-validation-summary="All" class="text-danger small mb-3 p-3 rounded-3 border-0" style="background: rgba(239, 68, 68, 0.1); color: #f87171;"></div>

                    <div class="mb-3">
                        <label class="form-label small text-secondary fw-bold">شماره موبایل (نام کاربری)</label>
                        <input asp-for="Username" class="form-control text-white border-0 py-3 px-3 rounded-3 shadow-none neon-input" placeholder="09123456789" style="background: rgba(15, 23, 42, 0.8); border: 1px solid rgba(255,255,255,0.08) !important;" />
                        <span asp-validation-for="Username" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small text-secondary fw-bold">رمز عبور</label>
                        <div class="input-group rounded-3 overflow-hidden" style="background: rgba(15, 23, 42, 0.8); border: 1px solid rgba(255,255,255,0.08);">
                            <input asp-for="Password" type="password" class="form-control border-0 text-white py-3 px-3 shadow-none bg-transparent" id="passwordInput" placeholder="••••••••" />
                            <button class="btn btn-transparent border-0 px-3 text-secondary" type="button" id="togglePasswordBtn" title="نمایش/مخفی کردن رمز">
                                👁️
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 rounded-3 fw-bold py-3 shadow-lg bg-gradient border-0" style="background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%); font-size: 15px;">
                        ورود به پنل کاربری 🚀
                    </button>
                </form>

                <hr class="text-secondary my-4 opacity-25">

                <div class="text-center">
                    <p class="text-secondary small mb-3">هنوز حساب کاربری نساخته‌اید؟</p>
                    <div class="d-flex gap-2 justify-content-center">
                        <a asp-action="RegisterJobSeeker" class="btn btn-outline-light btn-sm rounded-pill px-3 py-2 border-0 fw-semibold" style="background: rgba(255,255,255,0.04); font-size: 13px;">ثبت‌نام کارجو</a>
                        <a asp-action="RegisterEmployer" class="btn btn-outline-light btn-sm rounded-pill px-3 py-2 border-0 fw-semibold" style="background: rgba(255,255,255,0.04); font-size: 13px;">ثبت‌نام کارفرما</a>
                    </div>
                </div>

            </div>
        </div>

        <!-- ستون چپ: ویترین نئونی و جذاب (سیلیکون‌ولی استایل) -->
        <div class="col-lg-7 col-md-6 d-none d-md-flex align-items-center justify-content-center p-5 position-relative overflow-hidden" style="background: radial-gradient(circle at 50% 50%, #1e1b4b 0%, #0b0f19 80%);">
            
            <!-- نورهای نئونی متحرک پس‌زمینه -->
            <div style="position: absolute; top: 10%; right: 15%; width: 350px; height: 350px; background: radial-gradient(circle, rgba(99,102,241,0.2) 0%, rgba(0,0,0,0) 70%); filter: blur(70px); pointer-events: none;"></div>
            <div style="position: absolute; bottom: 15%; left: 10%; width: 400px; height: 400px; background: radial-gradient(circle, rgba(168,85,247,0.15) 0%, rgba(0,0,0,0) 70%); filter: blur(80px); pointer-events: none;"></div>

            <div class="text-center position-relative z-1 px-lg-5" style="max-width: 600px;">
                <div class="mb-4">
                    <span class="badge px-3 py-2 rounded-pill fw-bold shadow" style="background: rgba(99, 102, 241, 0.2); color: #818cf8; border: 1px solid rgba(99, 102, 241, 0.4);">
                        ✨ پلتفرم جامع استخدام و کاریابی
                    </span>
                </div>
                <h1 class="display-4 fw-bold text-white mb-4" style="letter-spacing: -2px; line-height: 1.2;">
                    پل ارتباطی میان <br><span style="background: linear-gradient(135deg, #818cf8 0%, #c084fc 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">برترین استعدادها و شرکت‌ها</span>
                </h1>
                <p class="text-secondary lead fs-6 mb-5" style="color: #94a3b8 !important;">
                    با HireFlow، کارجوها فرصت‌های شغلی رویایی‌شان را پیدا می‌کنند و کارفرماها به راحتی نیروهای متخصص جذب می‌کنند. محیطی امن، سریع و منظم.
                </p>

                <!-- کارت‌های شناور تزئینی -->
                <div class="row g-3 text-start">
                    <div class="col-6">
                        <div class="p-3 rounded-4 shadow-sm" style="background: rgba(30, 41, 59, 0.6); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.06);">
                            <div class="text-primary fs-4 mb-1">🎯</div>
                            <h6 class="fw-bold text-white mb-1">مدیریت هوشمند</h6>
                            <p class="text-secondary small mb-0">پیگیری لحظه‌ای وضعیت درخواست‌ها</p>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 rounded-4 shadow-sm" style="background: rgba(30, 41, 59, 0.6); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.06);">
                            <div class="text-success fs-4 mb-1">⚡</div>
                            <h6 class="fw-bold text-white mb-1">امن و سریع</h6>
                            <p class="text-secondary small mb-0">احراز هویت پیشرفته و اختصاصی</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>

    </div>
</div>

<style>
    .neon-input:focus {
        background: rgba(15, 23, 42, 0.95) !important;
        border-color: #6366f1 !important;
        box-shadow: 0 0 15px rgba(99, 102, 241, 0.25) !important;
        color: #fff !important;
    }
</style>

@section Scripts {
    <script>
        const toggleBtn = document.getElementById('togglePasswordBtn');
        const passwordInput = document.getElementById('passwordInput');

        if (toggleBtn && passwordInput) {
            toggleBtn.addEventListener('click', function () {
                const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
                passwordInput.setAttribute('type', type);
                this.textContent = type === 'password' ? '👁️' : '🙈';
            });
        }
    </script>
}